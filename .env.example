# Origen del sitio, sin ruta ni barra final (se usa en canonicals, metadataBase, sitemap y OpenGraph).
# La ruta base /es/multas se añade en el código (src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://ododex.com

# Identificador de cliente de Google AdSense, con el formato ca-pub-<16 dígitos>.
# Vacío por defecto: sin identificador válido no se carga el script ni se muestra
# el botón "Configurar cookies" del pie.
NEXT_PUBLIC_ADSENSE_CLIENT=
